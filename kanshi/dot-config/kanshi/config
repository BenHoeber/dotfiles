output "Acer Technologies ED273 T9DEE0133900" {
    alias $HOME_LEFT
    mode 1920x1080@60.000
    position 0,0
    scale 1
}

output "Acer Technologies ED273 T9DEE0053900" {
    alias $HOME_RIGHT
    mode 1920x1080@60.000
    position 1920,0
    scale 1
}

profile home {
  output $HOME_LEFT enable
  output $HOME_RIGHT enable
}
